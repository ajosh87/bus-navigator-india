# ─────────────────────────────────────────────────────────────────────────────
# Secrets — nothing in this block may ever reach a public remote.
#
# Every credential this project uses lives in a platform environment variable
# (Vercel / Cloudflare), never in a tracked file. `.env.example` is the only
# env file that is committed, and it holds names with empty values.
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
.envrc

# Cloudflare Workers local secrets (wrangler reads these for `wrangler dev`)
.dev.vars
.dev.vars.*

# Streamlit / Python secret stores
.streamlit/secrets.toml
secrets.toml
secrets.json
credentials.json
client_secret*.json
service-account*.json

# Keys, certificates and keystores
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.gpg
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk
known_hosts

# Generic credential dumps
**/secrets/
**/credentials/
*.secret
*token*.json
auth.json
.netrc
.htpasswd

# ─────────────────────────────────────────────────────────────────────────────
# Platform / deploy state (contains project + org identifiers)
# ─────────────────────────────────────────────────────────────────────────────
.vercel
.wrangler
.netlify
.serverless
.terraform/
*.tfstate
*.tfstate.*
.aws/
.gcloud/

