{
  "name": "pan-india-bus-navigator",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "dev:full": "vercel dev",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "setup": "node scripts/setup-env.js",
    "assets": "node scripts/generate-assets.js",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web --clear && node scripts/postexport.js",
    "deploy": "npm run build && npx vercel deploy --prod --yes"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "expo": "~51.0.28",
    "expo-av": "~14.0.7",
    "expo-camera": "~15.0.16",
    "expo-constants": "~16.0.2",
    "expo-file-system": "~17.0.1",
    "expo-status-bar": "~1.12.1",
    "gtfs-realtime-bindings": "^2.2.0",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~18.2.79",
    "sharp": "^0.33.5",
    "typescript": "^5.3.3"
  },
  "private": true
}
