# ── Login ────────────────────────────────────────────────────────────────────
# Generate both with:  node scripts/hash-password.js
# Without these, login always fails and the proxy denies every request — the
# app fails closed rather than sitting open.
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_USERNAME=admin

# `vercel dev` does not reliably read this file, so for local runs export these
# into the shell environment before starting it.

# ── Page reading (Anakin) ────────────────────────────────────────────────────
# Scrapes official ticketing pages so their fees and timings can be read aloud.
# Free tier at anakin.io gives 300 credits; the key starts with "ak-".
# Only ever called server-side — the client posts to /api/scrape/page.
ANAKIN_API_KEY=

# ── Live transit ─────────────────────────────────────────────────────────────
# Delhi's Open Transit Data portal is the only public real-time vehicle feed
# covering a city in this app. Register free at otd.delhi.gov.in.
# Without it the map still shows routes, stops and metro geography.
OTD_API_KEY=
# Only set this if the feed URL changes; there is a sane default.
OTD_FEED_URL=

# ── Sarvam ───────────────────────────────────────────────────────────────────
# Sarvam AI key, read only by the serverless proxy in api/sarvam/.
# Never prefix this with EXPO_PUBLIC_ — that would inline it into the client
# bundle, which is exactly what the proxy exists to prevent.
#
# Set it for real deployments with:
#   vercel env add SARVAM_API_KEY production
SARVAM_API_KEY=
